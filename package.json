{
  "name": "the-wheel-of-names",
  "version": "2.3.0",
  "private": true,
  "description": "Wheel of Names: desktop and web app with local recorded applause, celebrations and 1,000 entries",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage",
    "check": "node --check src/scripts/engine.js && node --check src/scripts/sound.js && node --check src/scripts/app.js && node --check desktop/main.cjs && node --test tests/*.test.cjs",
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "postinstall": "node scripts/vendor-confetti.cjs",
    "sync:web": "node scripts/sync-web.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wheelofnames.desktop",
    "productName": "The Wheel of Names",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  }
}
